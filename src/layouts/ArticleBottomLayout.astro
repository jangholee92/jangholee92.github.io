---
import type { CollectionEntry } from "astro:content"

type Props = {
  entry: CollectionEntry<"news"> | CollectionEntry<"projects">
}

const { entry } = Astro.props
---

{ (entry.collection === "news" || entry.collection === "projects") && (
  <div class="py-5 border-t border-black/10 dark:border-white/20 mt-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        {/* Previous post / project links could go here if needed */}
      </div>
    </div>
  </div>
)}
