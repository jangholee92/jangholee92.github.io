---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import PublicationList from "@components/PublicationList"
import { LAST_UPDATED } from "@consts"

const allPublicationsEntries = await getCollection("publications")
const publications = allPublicationsEntries.flatMap(entry => entry.data)
type Publication = typeof publications[number]

// Add new papers at the top of papers.json; stable sorting preserves their order within each year.
const sortByYear = (a: Publication, b: Publication) => b.year - a.year

const published = publications.filter(p => p.type === "Published").sort(sortByYear)
const underReview = publications.filter(p => p.type === "Under Review").sort(sortByYear)

const title = "Publications"
const description = "Peer-reviewed journal articles and research manuscripts."
---

<PageLayout title={title} description={description}>
  <TopLayout>
    <div class="animate">
      <div class="flex items-end justify-between">
        <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
          {title}
        </h1>
        <span class="text-xs opacity-50 mb-1">
          Last Updated: {LAST_UPDATED}
        </span>
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <PublicationList 
        client:load 
        published={published} 
        underReview={underReview} 
      />
    </div>
  </BottomLayout>
</PageLayout>
