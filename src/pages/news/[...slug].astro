---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"

// Create the static news pages
export async function getStaticPaths() {
	const posts = await getCollection("news")
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}))
}

// Get the requested post
type Props = CollectionEntry<"news">
const post = Astro.props
const { title, summary, date } = post.data
const { Content } = await post.render()

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<PageLayout title={title} description={summary}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={post}/>
      <div class="mt-4 flex items-center gap-2">
        <div class="text-xs uppercase px-2 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 font-semibold">
          {formattedDate}
        </div>
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={post} />
      <article class="news-article prose dark:prose-invert max-w-none">
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>

<style>
  .news-article :global(img) {
    width: 100%;
    max-width: 300px !important; /* Unified smaller size */
    height: 200px !important;
    object-fit: cover !important;
    margin: 2rem auto !important;
    border-radius: 1rem;
    border: 4px solid white;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
  .news-article :global(p) {
    @apply text-lg leading-relaxed text-black/80 dark:text-white/80;
  }
</style>