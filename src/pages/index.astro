---
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS, LATEST_UPDATES } from "@consts"

const isPdfUrl = (url: string) => url.toLowerCase().endsWith(".pdf")
const fileNameFromUrl = (url: string) => url.split("/").pop() || undefined
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-lg p-5 space-y-12 pb-16">

      <!-- Professional Introduction Section -->
      <section class="animate mt-12">
        <div class="flex flex-col md:flex-row items-center gap-8 mb-12">
          <img src="/profile.png" alt="Jangho Lee" class="rounded-full w-40 h-40 object-cover border-4 border-black/5 dark:border-white/10 shadow-xl" />
          <div class="text-center md:text-left">
            <h1 class="text-4xl font-bold text-black dark:text-white mb-2">Jangho Lee, Ph.D.</h1>
            <p class="text-xl text-blue-600 dark:text-blue-400 font-medium mb-4">Postdoctoral Researcher @ NYU</p>
            <p class="text-sm opacity-70 leading-relaxed">
              Courant Institute of Mathematical Sciences<br/>
              New York University
            </p>
          </div>
        </div>

        <article class="prose dark:prose-invert max-w-none">
          <p class="text-lg leading-relaxed">
            I am an atmospheric scientist and researcher at the <strong>Courant Institute of Mathematical Sciences, New York University</strong>. 
            My work sits at the intersection of <strong>Climate Science, GeoAI, and Urban Resilience</strong>.
          </p>
        </article>
      </section>

      <!-- Latest Updates Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <p class="font-bold text-xl text-black dark:text-white">
              Latest Updates
            </p>
            <div class="flex gap-3">
              <a href="/news" class="text-xs underline underline-offset-4 opacity-60 hover:opacity-100 transition-opacity">
                News
              </a>
              <a href="/publications" class="text-xs underline underline-offset-4 opacity-60 hover:opacity-100 transition-opacity">
                Publications
              </a>
            </div>
          </div>
          <ul class="space-y-4">
            {LATEST_UPDATES.slice(0, 5).map((update) => {
              const isPdf = isPdfUrl(update.url)
              return (
                <li>
                  <a href={update.url} download={isPdf ? fileNameFromUrl(update.url) : undefined} aria-label={isPdf ? `Download PDF: ${update.title}` : update.title} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
                    <div class="w-full group-hover:text-black group-hover:dark:text-white blend">
                      <div class="flex items-center gap-2 mb-2">
                        <div class="text-[10px] uppercase px-1.5 py-0.5 rounded border border-black/10 dark:border-white/20 opacity-60">
                          {update.type}
                        </div>
                      </div>
                      <div class="font-semibold text-black dark:text-white line-clamp-2">
                        {update.title}
                      </div>
                      <div class="text-sm line-clamp-2 opacity-70 mt-1">
                        {update.summary}
                      </div>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white shrink-0">
                      <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
                      <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
                    </svg>
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="animate">
        <div>
          <p class="font-bold text-xl text-black dark:text-white mb-4">
            Connect
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {SOCIALS.map(social => (
              <a href={social.HREF} target="_blank" class="flex items-center gap-3 p-3 rounded-lg border border-black/5 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                <span class="font-medium text-sm">{social.NAME}</span>
                <span class="text-xs opacity-50 truncate">{social.TEXT}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

    </div>
  </div>
</PageLayout>
